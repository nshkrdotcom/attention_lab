{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attention Lab Screen Promotion Report",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "run_name",
    "config_path",
    "screen_config_path",
    "screen_run_dir",
    "attention_type",
    "stage",
    "max_step_reached",
    "expected_screen_steps",
    "loss_descended",
    "nan_or_inf_seen",
    "final_screen_train_loss",
    "final_screen_val_loss",
    "first_val_loss",
    "final_val_loss",
    "median_tokens_per_sec",
    "peak_vram_mb",
    "peak_vram_allocated_mb",
    "diagnostics_present",
    "diagnostics_non_degenerate",
    "mechanism_check_name",
    "mechanism_active",
    "mechanism_activity_summary",
    "destructive_test_present",
    "destructive_test_effect_summary",
    "promotion_recommendation",
    "promotion_blockers",
    "promotion_reason",
    "created_at",
    "source_git_commit",
    "source_dirty"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "experiment_id": { "type": ["string", "null"] },
    "run_id": { "type": "string" },
    "run_name": { "type": "string" },
    "config_path": { "type": "string" },
    "screen_config_path": { "type": "string" },
    "screen_run_dir": { "type": "string" },
    "artifact_paths": { "type": "object" },
    "attention_type": { "type": "string" },
    "stage": { "type": "string", "const": "SCREEN" },
    "max_step_reached": { "type": ["integer", "null"] },
    "expected_screen_steps": { "type": "integer", "minimum": 1 },
    "loss_descended": { "type": "boolean" },
    "nan_or_inf_seen": { "type": "boolean" },
    "final_screen_train_loss": { "type": ["number", "null"] },
    "final_screen_val_loss": { "type": ["number", "null"] },
    "first_val_loss": { "type": ["number", "null"] },
    "final_val_loss": { "type": ["number", "null"] },
    "median_tokens_per_sec": { "type": ["number", "null"] },
    "peak_vram_mb": { "type": ["number", "null"] },
    "peak_vram_allocated_mb": { "type": ["number", "null"] },
    "diagnostics_present": { "type": "boolean" },
    "diagnostics_non_degenerate": { "type": "boolean" },
    "mechanism_check_name": { "type": ["string", "null"] },
    "mechanism_active": { "type": ["boolean", "null"] },
    "mechanism_activity_summary": { "type": "object" },
    "destructive_test_present": { "type": "boolean" },
    "destructive_test_effect_summary": { "type": ["object", "null"] },
    "promotion_recommendation": {
      "type": "string",
      "enum": ["promote", "kill", "needs_investigation"]
    },
    "promotion_blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "promotion_reason": { "type": "string" },
    "created_at": { "type": "string" },
    "source_git_commit": { "type": ["string", "null"] },
    "source_dirty": { "type": "boolean" }
  },
  "additionalProperties": true
}
